{
    "name": "hub-agent",
    "version": "0.0.1",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "start": "node --loader ts-node/esm src/index.ts",
        "dev": "node --loader ts-node/esm src/index.ts",
        "check-types": "tsc --noEmit",
        "test": "jest"
    },
    "nodemonConfig": {
        "watch": [
            "src",
            "../core/dist"
        ],
        "ext": "ts,json",
        "exec": "node --enable-source-maps --loader ts-node/esm src/index.ts"
    },
    "dependencies": {
        "@elizaos/adapter-bullmq": "workspace:*",
        "@elizaos/adapter-mongodb": "workspace:*",
        "@elizaos/adapter-redis": "workspace:*",
        "@elizaos/core": "workspace:*",
        "@types/node": "^22.13.1",
        "bullmq": "^5.37.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/xlsx": "^0.0.36",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "ts-node": "10.9.2",
        "tsup": "8.3.5"
    }
}